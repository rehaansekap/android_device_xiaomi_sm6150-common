<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/zram_title">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="zram_master_switch"
        android:title="@string/zram_enable_title"
        android:defaultValue="true" />

    <Preference
        android:key="zram_current_status"
        android:title="@string/zram_current_status_title"
        android:selectable="false" />

    <PreferenceCategory
        android:key="zram_config_category"
        android:title="@string/zram_config_category_title">

        <SeekBarPreference
            android:key="zram_slider_level"
            android:title="@string/zram_slider_title"
            android:summary="@string/zram_slider_summary"
            android:min="1"
            android:max="8"
            settings:showSeekBarValue="true" />

        <EditTextPreference
            android:key="zram_custom_mb"
            android:title="@string/zram_custom_title"
            android:dialogTitle="@string/zram_custom_dialog_title"
            android:summary="@string/zram_custom_summary" />

    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="zram_footer"
        android:title="@string/zram_footer_text"
        android:selectable="false" />

</PreferenceScreen>
