allow hal_power_default touchfeature_device:chr_file rw_file_perms;

# To do powerhint on nodes defined in powerhint.json
allow hal_power_default vendor_latency_device:chr_file rw_file_perms;

allow hal_power_default sysfs_touchpanel:dir search;
allow hal_power_default sysfs_touchpanel:{ file lnk_file } rw_file_perms;

allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;
allow hal_power_default vendor_sysfs_devfreq:dir r_dir_perms;
allow hal_power_default vendor_sysfs_devfreq:{ file lnk_file } rw_file_perms;
allow hal_power_default vendor_sysfs_kgsl:dir r_dir_perms;
allow hal_power_default vendor_sysfs_kgsl:{ file lnk_file } rw_file_perms;
allow hal_power_default vendor_sysfs_graphics:dir r_dir_perms;
allow hal_power_default vendor_sysfs_graphics:file r_file_perms;
set_prop(hal_power_default, vendor_power_prop)
