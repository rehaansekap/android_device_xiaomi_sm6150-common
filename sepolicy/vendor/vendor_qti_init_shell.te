# To set powerhal init property
set_prop(vendor_qti_init_shell, vendor_power_prop)

# For ZRAM setup
allow vendor_qti_init_shell block_device:dir search;
allow vendor_qti_init_shell ram_device:blk_file rw_file_perms;
allow vendor_qti_init_shell swap_block_device:blk_file rw_file_perms;
allow vendor_qti_init_shell sysfs_zram:dir search;
allow vendor_qti_init_shell sysfs_zram:file rw_file_perms;
allow vendor_qti_init_shell self:capability { sys_admin };
get_prop(vendor_qti_init_shell, zram_prop)
